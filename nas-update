#!/bin/bash
# nas-update — NAS update manager (interactive root script)
# Orchestrates nas-system-update, nas-system-upgrade, nas-docker-pull, nas-docker-up, nas-docker-prune
# Usage: nas-update

set -uo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

echo -e "${BOLD}=====================================================${RESET}"
echo -e "${BOLD}              NAS — Update Manager                   ${RESET}"
echo -e "${BOLD}=====================================================${RESET}"
echo ""

# ─────────────────────────────────────────────────────
# Phase 1: System analysis
# ─────────────────────────────────────────────────────
echo -e "${BOLD}--- Phase 1: System analysis (apt) ---${RESET}"
if ! nas-system-update; then
    echo -e "${RED}❌ System update analysis failed.${RESET}" >&2
    exit 1
fi
echo ""

# ─────────────────────────────────────────────────────
# Phase 2: Docker analysis (pull + diff detection)
# ─────────────────────────────────────────────────────
echo -e "${BOLD}--- Phase 2: Docker analysis ---${RESET}"

if ! nas-docker-pull; then
    echo -e "${RED}❌ Docker update analysis failed.${RESET}" >&2
    exit 1
fi

echo ""

# ─────────────────────────────────────────────────────
# Phase 3: System upgrade
# ─────────────────────────────────────────────────────
echo -e "${BOLD}--- Phase 3: System upgrade ---${RESET}"

while true; do
    read -p "Apply apt full-upgrade? [y/n]: " sys_choice </dev/tty
    case "$sys_choice" in
        [yY]*)
            if ! nas-system-upgrade; then
                echo -e "${RED}❌ System upgrade failed.${RESET}" >&2
                exit 1
            fi
            break
            ;;
        [nN]*)
            echo -e "${YELLOW}⏭  System upgrade skipped.${RESET}"
            break
            ;;
        *) echo "Please answer y or n." ;;
    esac
done

echo ""

# ─────────────────────────────────────────────────────
# Phase 4: Docker upgrade
# ─────────────────────────────────────────────────────
echo -e "${BOLD}--- Phase 4: Docker upgrade ---${RESET}"

docker_json=$(cat /tmp/nas-docker-pull.json 2>/dev/null || echo '{"count":0,"containers":[]}')
docker_count=$(python3 -c 'import json, sys; print(json.load(sys.stdin).get("count", 0))' <<<"$docker_json" 2>/dev/null || echo 0)

if [ "$docker_count" -eq 0 ]; then
    echo -e "${GREEN}✅ No containers to update.${RESET}"
    echo ""
    echo -e "${BOLD}=====================================================${RESET}"
    echo -e "${GREEN}                     Done!                          ${RESET}"
    echo -e "${BOLD}=====================================================${RESET}"
    exit 0
fi

read -p "Update ALL containers? [y]es (All) / [n]o (Choose per stack) / [s]kip (Skip all): " docker_choice </dev/tty
docker_status=0
case "$docker_choice" in
    [yY]*) nas-docker-up --from-cache /tmp/nas-docker-pull.json --yes || docker_status=$? ;;
    [nN]*) nas-docker-up --from-cache /tmp/nas-docker-pull.json --selective || docker_status=$? ;;
    [sS]*) echo -e "${YELLOW}⏭  Docker upgrade skipped.${RESET}"; exit 0 ;;
    *) echo "Please answer y, n or s."; exit 2 ;;
esac
if [ "$docker_status" -ne 0 ]; then
    echo -e "${RED}❌ Docker upgrade failed.${RESET}" >&2
    exit "$docker_status"
fi

# ─────────────────────────────────────────────────────
# Phase 5: Cleanup
# ─────────────────────────────────────────────────────
echo ""
echo -e "${BOLD}--- Phase 5: Cleanup ---${RESET}"
while true; do
    read -p "Run Docker cleanup (remove dangling images)? [Y/n]: " prune_choice </dev/tty
    case "$prune_choice" in
        ""|[yY]*)
            if ! nas-docker-prune; then
                echo -e "${RED}❌ Docker cleanup failed.${RESET}" >&2
                exit 1
            fi
            break
            ;;
        [nN]*)
            echo -e "${YELLOW}⏭  Docker cleanup skipped.${RESET}"
            break
            ;;
        *) echo "Please answer y or n." ;;
    esac
done

if [ -f /var/run/reboot-required ]; then
    echo ""
    echo -e "${RED}⚠️  A system reboot is required.${RESET}"
    read -p "Reboot now? [y/N]: " reboot_choice </dev/tty
    case "$reboot_choice" in
        [yY]*) reboot ;;
    esac
fi

echo ""
echo -e "${BOLD}=====================================================${RESET}"
echo -e "${BOLD}                     Done!                           ${RESET}"
echo -e "${BOLD}=====================================================${RESET}"
